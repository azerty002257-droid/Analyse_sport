# ============================================================
# AnalyseSport-Football-Server – Configuration
# ============================================================
# Copier ce fichier vers .env et adapter les valeurs.
# NE JAMAIS commiter le fichier .env contenant des secrets.
# ============================================================

# --- Serveur ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Base de données ---
DB_TYPE=sqlite
# Pour PostgreSQL en production :
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=analysesport
# DB_USER=analysesport
# DB_PASSWORD=CHANGE_ME
DB_SQLITE_PATH=./data/analysesport.db

# --- Collecteurs Web ---
# Activer/désactiver chaque source individuellement
COLLECTOR_SOFASCORE_ENABLED=false
COLLECTOR_ZONSTAT_ENABLED=false
COLLECTOR_GENERIC_ENABLED=false

# --- Planificateur (en minutes) ---
SCHEDULE_MATCHES_UPCOMING=30
SCHEDULE_MATCHES_LIVE=5
SCHEDULE_MATCHES_FINISHED=120
SCHEDULE_TEAMS=360
SCHEDULE_STANDINGS=360
SCHEDULE_PLAYERS=720

# --- Cache ---
CACHE_TTL_MATCHES=300
CACHE_TTL_TEAMS=3600
CACHE_TTL_STANDINGS=3600
CACHE_TTL_PLAYERS=7200

# --- Rate Limiting API ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- CORS ---
CORS_ORIGIN=http://localhost:8080

# --- Logs ---
LOG_LEVEL=info
LOG_FILE=./logs/analysesport.log

# --- WebSocket ---
WS_ENABLED=true

# --- Gemini (optionnel) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash